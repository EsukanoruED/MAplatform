# apps/api — environment template. Copy to `apps/api/.env` and fill in real values.
# `.env` is git-ignored. NEVER commit a real secret to this repository.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma (migrations, client, seed).
DATABASE_URL="postgresql://ma_dev:CHANGE_ME@localhost:5432/medical_alliance_dev?schema=public"

# Separate database used by the API integration test suite. It is migrated and
# truncated by the tests, so it must never point at a database holding real data.
TEST_DATABASE_URL="postgresql://ma_dev:CHANGE_ME@localhost:5432/medical_alliance_test?schema=public"

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Origin allowed to call the API with credentials. In development the Vite dev
# server proxies /api, so the browser sees one origin and no CORS is needed.
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Signing secret for the session cookie. Generate a fresh random value per
# environment, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The placeholder below is NOT a secret and is rejected when NODE_ENV=production.
SESSION_SECRET="dev-only-insecure-placeholder-change-me"

# Session cookie name and lifetimes (minutes). Admin sessions are deliberately
# shorter-lived than company sessions.
SESSION_COOKIE_NAME=ma.sid
SESSION_TTL_COMPANY_MINUTES=480
SESSION_TTL_ADMIN_MINUTES=60

# ---------------------------------------------------------------------------
# Login rate limiting
# ---------------------------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Document storage  (Phase 2)
# ---------------------------------------------------------------------------
# Which StorageAdapter backs document bytes. Only "local" is implemented in
# Phase 2; see apps/api/src/services/storage.ts for the interface an S3/GCS
# driver would implement.
#
# LIMITATION: local disk is per-instance and not replicated, so it is unsuitable
# for production or for more than one API instance. Phase 6 replaces it with
# object storage.
STORAGE_DRIVER=local

# Where the local driver writes. MUST stay outside apps/web so clinical files can
# never be served as static frontend assets. Defaults to apps/api/var/storage,
# which is git-ignored.
# STORAGE_LOCAL_DIR=./var/storage

# Largest accepted upload, in bytes (default 10 MB). Enforced at the multipart
# parser and again in the document service.
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Billing  (Phase 2)
# ---------------------------------------------------------------------------
# NO PAYMENT PROVIDER IS INTEGRATED. Phase 2 records what is owed; it never
# captures funds. Prices are in minor units (halalas), so 25000 = SAR 250.00.
BILLING_CURRENCY=SAR
BILLING_CHECKUP_PRICE_MINOR=25000
BILLING_CERTIFICATE_PRICE_MINOR=40000

# ---------------------------------------------------------------------------
# Seed / demo accounts  (development convenience only)
# ---------------------------------------------------------------------------
# The seed script hashes this password for every demo account it creates. It is a
# well-known development value; a production database must never be seeded with it.
#   Company A admin      : ops@northgate-industrial.example
#   Company A requester  : requests@northgate-industrial.example
#   Company B admin      : ops@harbourline-logistics.example
#   Platform admin       : admin@medicalalliance.example
#   Platform reviewer    : reviewer@medicalalliance.example
SEED_DEMO_PASSWORD="DemoPassw0rd!"
