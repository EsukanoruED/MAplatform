// Medical Alliance Platform — Phase 1 + Phase 2 schema.
//
// Tenancy rule: every tenant-owned table carries a non-nullable `companyId`. That
// column is the only source of tenant truth; the API always derives it from the
// authenticated server-side session, never from client input. Foreign keys back to
// Company use onDelete: Restrict so a company's clinical history can never be
// cascade-deleted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — statuses, roles and types are never free-text strings.
// ---------------------------------------------------------------------------

enum BillingType {
  PER_REQUEST
  SETTLEMENT
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CompanyUserRole {
  COMPANY_ADMIN
  COMPANY_REQUESTER
}

enum AdminUserRole {
  ADMIN
  REVIEWER
}

enum RequestType {
  CHECKUP
  FITNESS_CERTIFICATE
}

enum RequestStatus {
  SUBMITTED
  PENDING_PAYMENT
  APPROVED
  AT_LAB
  RESULTS_RECEIVED
  UNDER_REVIEW
  COMPLETE
  REJECTED
}

enum PaymentMethod {
  PER_REQUEST
  SETTLEMENT
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ActorType {
  COMPANY_USER
  ADMIN_USER
  SYSTEM
}

/// What a stored file represents. Drives retention and who may see it.
enum DocumentType {
  RESULT
  CERTIFICATE
  ATTACHMENT
}

enum LabNotificationStatus {
  PENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Tenants and identities
// ---------------------------------------------------------------------------

/// A client organisation. The tenant boundary of the whole platform.
model Company {
  id          String        @id @default(uuid())
  legalName   String
  billingType BillingType   @default(PER_REQUEST)
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  users     CompanyUser[]
  employees Employee[]
  requests  Request[]
  documents Document[]
  payments  Payment[]

  @@index([status])
}

/// A person acting on behalf of one Company. Deliberately a different table from
/// AdminUser so no code path can promote a tenant account to platform admin.
model CompanyUser {
  id           String          @id @default(uuid())
  companyId    String
  name         String
  email        String          @unique
  passwordHash String
  role         CompanyUserRole @default(COMPANY_REQUESTER)
  active       Boolean         @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdRequests Request[] @relation("RequestCreatedBy")

  @@index([companyId])
}

/// Medical Alliance staff. Separate table from CompanyUser — see the comment above.
model AdminUser {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         AdminUserRole @default(REVIEWER)
  active       Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ---------------------------------------------------------------------------
// Tenant-owned clinical records
// ---------------------------------------------------------------------------

/// A worker belonging to one Company.
model Employee {
  id          String    @id @default(uuid())
  companyId   String
  fullName    String
  nationalId  String
  role        String?
  dateOfBirth DateTime?
  site        String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requests Request[]

  // A national ID identifies a worker within one company, not globally.
  @@unique([companyId, nationalId])
  @@index([companyId])
}

/// A partner laboratory. Platform-wide, not tenant-owned.
model Lab {
  id           String   @id @default(uuid())
  name         String
  contactEmail String   @unique
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requests      Request[]
  notifications LabNotification[]
}

/// A checkup or fitness-certificate request. The core business record.
model Request {
  id              String        @id @default(uuid())
  companyId       String
  employeeId      String
  type            RequestType
  status          RequestStatus @default(SUBMITTED)
  paymentMethod   PaymentMethod @default(PER_REQUEST)
  paymentStatus   PaymentStatus @default(PENDING)
  assignedLabId   String?
  createdByUserId String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedLab      Lab?                 @relation(fields: [assignedLabId], references: [id], onDelete: Restrict)
  createdBy        CompanyUser?         @relation("RequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  statusEvents     RequestStatusEvent[]
  documents        Document[]
  payments         Payment[]
  labNotifications LabNotification[]

  // Composite index serves the company dashboard's tenant-scoped queue.
  @@index([companyId, status])
  // Plain status index serves the admin console's cross-company queue.
  @@index([status])
  @@index([employeeId])
}

/// Append-only audit trail of every status transition on a Request.
model RequestStatusEvent {
  id            String         @id @default(uuid())
  requestId     String
  fromStatus    RequestStatus?
  toStatus      RequestStatus
  changedByType ActorType
  changedById   String?
  note          String?
  changedAt     DateTime       @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, changedAt])
}

// ---------------------------------------------------------------------------
// Phase 2 — documents, payments and lab dispatch
// ---------------------------------------------------------------------------

/// A file attached to a Request: a lab result, an issued fitness certificate, or
/// a supporting attachment.
///
/// `companyId` is denormalised from the parent Request on purpose. Tenant checks
/// then never depend on a join, so a document query cannot accidentally be written
/// without its tenant filter. The service layer always writes it from the parent
/// request's companyId, never from client input.
///
/// Only the storage KEY is persisted. Bytes live behind the StorageAdapter
/// (see src/services/storage.ts) and are streamed through an authorised endpoint,
/// never served from the web app's public assets.
model Document {
  id             String       @id @default(uuid())
  companyId      String
  requestId      String
  type           DocumentType
  fileName       String
  contentType    String
  byteSize       Int
  /// Server-generated opaque key. Never a client-supplied filename.
  storageKey     String       @unique
  checksum       String?
  uploadedByType ActorType
  uploadedById   String?
  uploadedAt     DateTime     @default(now())
  /// Certificates expire; results and attachments generally do not.
  expiryDate     DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([requestId])
  @@index([companyId, type])
  // Serves the expiring-certificates dashboard query.
  @@index([expiryDate])
}

/// A charge against a company, optionally tied to one request.
///
/// Amounts are stored as integer minor units (halalas/cents) rather than Decimal:
/// integers are exact, and they serialise to JSON losslessly, which Prisma's
/// Decimal does not.
model Payment {
  id                String        @id @default(uuid())
  companyId         String
  requestId         String?
  amountMinor       Int
  currency          String        @default("SAR")
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  /// Set by whichever payment provider is integrated later. Null in development.
  providerReference String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  request Request? @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([requestId])
}

/// One dispatch of a request to a laboratory.
///
/// Phase 2 records the intent and the outcome; actually sending the mail is the
/// job of a provider that is not configured yet, so rows stay PENDING in
/// development. See src/services/labNotification.ts.
model LabNotification {
  id                String                @id @default(uuid())
  requestId         String
  labId             String
  status            LabNotificationStatus @default(PENDING)
  sentAt            DateTime?
  emailMessageId    String?
  inboundReceivedAt DateTime?
  lastError         String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  lab     Lab     @relation(fields: [labId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([labId, status])
}

// ---------------------------------------------------------------------------
// Infrastructure
// ---------------------------------------------------------------------------

/// The express-session store table, owned at runtime by connect-pg-simple.
///
/// Declared here ONLY so Prisma knows the table legitimately belongs to this
/// schema — without it, every `migrate dev` plans to drop the live session table.
/// No application code queries this model; session reads and writes go through
/// the session middleware, never through the Prisma client.
model UserSession {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("user_sessions")
}
