# Normalize line endings to LF in the repo; Git converts on checkout for Windows
* text=auto eol=lf

# SVGs — keep as text, normalize to LF
*.svg text eol=lf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
